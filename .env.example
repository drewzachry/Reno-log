# Copy to .env.local. Values come from the Supabase dashboard (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (or legacy anon) key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional chat settings. CHAT_MODEL picks the Claude model for chat (default
# claude-opus-5-5); CHAT_EFFORT is low, medium (default) or high;
# CHAT_DAILY_LIMIT caps messages per person per 24 hours (default 150).
CHAT_MODEL=
CHAT_EFFORT=
CHAT_DAILY_LIMIT=
# Optional document reading settings: DOCS_MODEL (default claude-opus-5-5)
# and DOCS_EFFORT (low, medium (default) or high).
DOCS_MODEL=
DOCS_EFFORT=
# Optional: invite emails. Without a verified domain, Resend only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM=Reno Logbook <onboarding@resend.dev>
# Optional: the app works out its own address from the request if unset.
APP_URL=
