# Copy to .env.local. Google values come from Google Cloud Console — see SETUP.md
# for the exact steps (create a project, enable APIs, OAuth consent screen,
# OAuth client, Picker API key).
#
# The OAuth web client id. Safe in the browser: it names the app, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Developer key for the Google Picker (separate from the OAuth client id above).
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Still needed for now: sign-in, project creation and storage have moved to
# the user's own Google Drive (see CLAUDE.md), but the rest of the app
# (budget, decisions, chat, documents) hasn't been migrated off Supabase yet.
# Values come from the Supabase dashboard (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (or legacy anon) key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional chat settings. CHAT_MODEL picks the Claude model for chat (default
# claude-opus-5-5); CHAT_EFFORT is low, medium (default) or high;
# CHAT_DAILY_LIMIT caps messages per person per 24 hours (default 150).
CHAT_MODEL=
CHAT_EFFORT=
CHAT_DAILY_LIMIT=
# Optional document reading settings: DOCS_MODEL (default claude-opus-5-5)
# and DOCS_EFFORT (low, medium (default) or high).
DOCS_MODEL=
DOCS_EFFORT=
# Optional: invite emails. Without a verified domain, Resend only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM=Reno Logbook <onboarding@resend.dev>
# Optional: the app works out its own address from the request if unset.
APP_URL=
